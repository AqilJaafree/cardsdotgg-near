# Copy to .env. Never commit .env or print these values.
# Owner account: deploys the contracts, funds the reserve, seeds demo escrow. Needs testnet NEAR (https://near-faucet.io/).
NEAR_OWNER_ID=
NEAR_OWNER_KEY=
# Keeper account: the only account that can write rates and the NEAR price. Defaults to the owner.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
# NEAR testnet RPC, where the game lives.
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com
# NEAR mainnet RPC, read by the one-shot keeper for Rhea pool data.
NEAR_MAINNET_RPC=https://rpc.mainnet.near.org
# The Rhea pools used are recorded in keeper/src/sources.ts and shared/rate-sources.json.
